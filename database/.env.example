# Copy this file to the repository root as .env before running docker compose.
# Replace both values with unique local-only passwords. Never commit the .env file.
MYSQL_DATABASE=aegiscare
MYSQL_USER=aegiscare_app
MYSQL_PASSWORD=REPLACE_WITH_A_UNIQUE_LOCAL_APP_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_UNIQUE_LOCAL_ROOT_PASSWORD
