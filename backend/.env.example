# Required: generate a unique random value of at least 32 bytes.
AEGISCARE_JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES

# Local MySQL 8 connection (see compose.yaml and database/.env.example).
AEGISCARE_REQUIRE_MYSQL=true
AEGISCARE_MYSQL_JDBC_URL=jdbc:mysql://localhost:3306/aegiscare?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
AEGISCARE_MYSQL_USERNAME=aegiscare_app
AEGISCARE_MYSQL_PASSWORD=REPLACE_WITH_THE_LOCAL_MYSQL_APP_PASSWORD

# Local-only synthetic data and first administrator.
AEGISCARE_DEMO_DATA=true
AEGISCARE_BOOTSTRAP_ADMIN_ENABLED=true
AEGISCARE_BOOTSTRAP_ADMIN_EMAIL=admin@localhost.test
AEGISCARE_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_12_TO_72_BYTE_PASSWORD
AEGISCARE_BOOTSTRAP_ADMIN_NAME=AegisCare Administrator
AEGISCARE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional Google Cloud voice integration.
GOOGLE_CLOUD_API_KEY=
